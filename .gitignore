# dependencies
node_modules/
.pnp
.pnp.*

# builds
.next/
out/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# the bridge fork's dist must be committed (wizard installs the prebuilt
# binary from a fresh clone — rebuild is not possible on the speaker)
!station-setup/quasar-bridge-fork/dist/
!station-setup/quasar-bridge-fork/dist/**

# env and secrets — never commit values
.env
.env.*
!**/.env.example
secrets/
*.pem
*.key

# logs
*.log
logs/

# app routes literally named "logs" — source, not runtime logs
!panel/app/logs/
!panel/app/api/logs/

# os / editor
.DS_Store

# large local models (GigaAM / Piper / sherpa) — not part of the repo
**/*.onnx
**/*.ort
voice-chain/models/
voice-chain/**/gigaam*/
voice-chain/**/piper*/
voice-chain/**/sherpa*/

# local OpenCode session backups (may contain host-specific config)
opencode.json.bak-*

# launchd unit with a live API key — publish voice-chain/launchd.plist.example instead
voice-chain/com.yaroslav.station-voice.plist

# helper that reads the LiteLLM key out of .env and can write it to a file
agent-service/scripts-remote/probe.sh

# local OpenCode workspace (kept locally, not part of the repo)
.opencode/

# UI screenshots from verify runs — heavy, reproducible via shots-station/verify.mjs
shots-station/*.png
