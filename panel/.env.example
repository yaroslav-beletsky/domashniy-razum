# LiteLLM (OpenAI-совместимый). Из colima-контейнера на Mac mini живой адрес —
# http://host.docker.internal:4000 (см. PORT.md на хосте).
LITELLM_BASE_URL=http://host.docker.internal:4000

# Ключ LiteLLM. ТОЛЬКО сервер: в UI/API не отдаётся, в образ не попадает.
LITELLM_API_KEY=

# Голосовая цепочка (STT/TTS/ask). Поднята на отдельном хосте (launchd).
VOICE_CHAIN_URL=http://192.168.88.23:10702

# Станции с quasar-bridge через adb (LAN tcpip), через запятую.
ADB_DEVICES=192.168.88.79:5555

# DSN Postgres LiteLLM для статистики (только чтение). Панель в сети `home` — DNS litellm-db.
LITELLM_PG_DSN=

# belch-voice (Wyoming-мост). Offline — штатный режим панели.
BELCH_VOICE_HOST=host.docker.internal
BELCH_VOICE_PORT=10700

# Мастер «Добавить колонку» (ветка A). Все значения — дефолты, можно не задавать.
# Стенд lite-kit (DNS+HTTPS, самоподписанный сертификат — панель ходит с verify=false только к нему).
STAND_BASE_URL=https://192.168.88.23
# Подсеть для поиска колонок: сканируется <subnet>.0/24 по TCP :5555.
WIZARD_LAN_SUBNET=192.168.88
# Целевая прошивка (критерий шага OTA): подстрока, например 0.369.1.46.
WIZARD_TARGET_FIRMWARE=0.369.1.46
# Каталог со скриптами station-setup/ внутри контейнера (монтируется compose-файлом, ro).
STATION_SETUP_DIR=/opt/station-setup

# Мост quasar-bridge для шага «мост» мастера: ставим ЛОКАЛЬНЫЙ ФОРК со сменой голоса TTS
# (готовый бандл из station-setup/quasar-bridge-fork/dist, он смонтирован в /opt/station-setup:ro).
# Бандла нет → фолбэк: релиз GitHub v0.7.4 (тот отвечает женским голосом).
# WIZARD_BRIDGE_VERSION=0.7.4
# Каталог с форк-бандлом (пусто = всегда апстрим с GitHub):
# WIZARD_BRIDGE_FORK_DIST=/opt/station-setup/quasar-bridge-fork/dist
# Голос ответа моста: пишется в /data/opt/quasar-bridge/tts.override (откат — rm tts.override).
WIZARD_BRIDGE_VOICE=ermil
# WIZARD_BRIDGE_DEFAULT_MODEL=cp-self-kimi-k2.5
# Ручная подмена бандла (перекрывает форк и апстрим; пути внутри контейнера):
#  целый пакет (в формате релиза; рядом <файл>.sha256):
# WIZARD_BRIDGE_TARBALL=/opt/station-setup/quasar-bridge-fork/dist/quasar-bridge-linux-arm64.tar.gz
#  или только бинарь поверх АПСТРИМ-пакета (поверх форка не подменять — потеряется голос):
# WIZARD_BRIDGE_BINARY=/opt/station-setup/quasar-bridge-fork/dist/quasar-bridge-arm64
