+// station-llm fork: изолированная проба голосов. Если в tts.override есть строка
+// probe=voice[@emotion],voice[@emotion],… то после настоящей озвучки мост шлёт серверу
+// по одному пробному TtsGenerate на каждого кандидата (текст "а"). Ответы на пробы
+// отбрасываются (запрос помечен canceled), результат смотреть в service.log:
+// tts_probe_sent (id пробы) + frame EventException (exception, ref=id) или TtsSpeak (ref=id).
+// Не чаще раза в 20 с, максимум 12 кандидатов.
+var lastProbe atomic.Int64
+
+func readProbeList(path string) []string {
+	data, err := os.ReadFile(path)
+	if err != nil || len(data) > 4096 {
+		return nil
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		k, v, ok := strings.Cut(strings.TrimSpace(line), "=")
+		if ok && strings.TrimSpace(k) == "probe" {
+			var out []string
+			for _, item := range strings.Split(v, ",") {
+				if item = strings.TrimSpace(item); item != "" && len(out) < 12 {
+					out = append(out, item)
+				}
+			}
+			return out
+		}
+	}
+	return nil
+}
+
+func (n *Native) runTtsProbes(p *nativeRequest) {
+	items := readProbeList(ttsOverridePath)
+	if len(items) == 0 {
+		return
+	}
+	now := time.Now().UnixMilli()
+	if prev := lastProbe.Load(); now-prev < 20000 || !lastProbe.CompareAndSwap(prev, now) {
+		return
+	}
+	n.wg.Go(func() {
+		for _, item := range items {
+			voice, emotion, _ := strings.Cut(item, "@")
+			g := &tts.TTtsGenerate{Text: new("а"), Lang: new("ru-RU"), Format: new("audio/opus")}
+			if voice != "" {
+				g.Voice = new(voice)
+			}
+			if emotion != "" {
+				g.Emotion = new(emotion)
+			}
+			id := newID()
+			dummy := &nativeRequest{id: id, ttsID: id, canceled: true}
+			n.mu.Lock()
+			n.tts[id] = dummy
+			n.mu.Unlock()
+			slog.Info("tts_probe_sent", "probe", id, "voice", voice, "emotion", emotion)
+			t := &client.TClientMessage{Message: &client.TClientMessage_Event{Event: &client.TClientMessage_TEvent{Header: &header.TEventHeader{MessageId: id}, Event: &client.TClientMessage_TEvent_TtsGenerate{TtsGenerate: g}}}}
+			b, err := (wire.Frame{Client: t, Prefix: []byte("AAPI")}).Marshal()
+			if err == nil {
+				err = n.up(p.ctx, websocket.MessageBinary, b)
+			}
+			if err != nil {
+				slog.Warn("tts_probe_failed", "probe", id, "voice", voice)
+			}
+			time.AfterFunc(60*time.Second, func() {
+				n.mu.Lock()
