{
  "name": "agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin OpenAI-compatible agent gateway for station-llm (Yandex Station voice pipeline)",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
