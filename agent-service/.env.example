# Порт и хост HTTP-шлюза агента.
PORT=4100
HOST=0.0.0.0

# Домашний LiteLLM (OpenAI-совместимый). Значение ключа не коммитить.
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=

# Токен админ-API агента. Только сервер.
AGENT_ADMIN_TOKEN=

# Каталог секретов (mcp.env, pepper, sqlite). В git не попадает.
AGENT_SECRETS_DIR=secrets/agent
AGENT_DB_PATH=
AGENT_SECRETS_FILE=
KEY_PEPPER=
KEY_PEPPER_FILE=

# Разрешённые stdio-команды MCP, через запятую. Пусто — stdio выключен.
MCP_STDIO_ALLOW=

# Интервал health-check MCP, мс.
MCP_HEALTH_INTERVAL_MS=30000
